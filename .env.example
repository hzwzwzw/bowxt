# Host loopback ports
WEB_PORT=8787
NOVNC_PORT=6080
VNC_PORT=5900

# window = WeChat only; desktop = full XFCE desktop
VNC_SCOPE=window

# Minimum 1.5 seconds. One poll switches one visible chat.
BOWXT_POLL_GAP=1.5

# polling = round-robin all chats; unread = switch only for visible unread badges.
BOWXT_SYNC_MODE=polling

# Visible key/mouse pacing in seconds. Safe UI range: 0.06 to 0.30.
BOWXT_ACTION_DELAY=0.12

# One verified profile-card lookup per group poll; set 0 to disable sender names.
BOWXT_UIA_SENDER=1
# Comma-separated names by which other group members can @ this account.
BOWXT_MY_NAMES=
