# Host loopback ports
WEB_PORT=8787
NOVNC_PORT=6080
VNC_PORT=5900

# window = WeChat only; desktop = full XFCE desktop
VNC_SCOPE=window

# Minimum 1.5 seconds. One poll switches one visible chat.
BOWXT_POLL_GAP=2.0

# Opt in only when group sender names are worth the visible profile-card clicks.
BOWXT_UIA_SENDER=0
