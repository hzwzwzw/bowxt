#!/usr/bin/env bash
set -euo pipefail

install -d -m 0700 -o wechat -g wechat /home/wechat
install -d -m 0700 -o wechat -g wechat /home/wechat/.config /home/wechat/.cache
install -d -m 0755 -o wechat -g wechat /home/wechat/Desktop /home/wechat/Downloads
install -d -m 0700 -o wechat -g wechat /home/wechat/.local /home/wechat/.local/share
install -d -m 0700 -o wechat -g wechat /home/wechat/.local/share/bowxt
install -d -m 0755 -o wechat -g wechat /run/bowxt

runuser -u wechat -- env HOME=/home/wechat /usr/local/bin/bowxt-configure-fcitx5

exec /usr/bin/supervisord -c /etc/supervisor/supervisord.conf
