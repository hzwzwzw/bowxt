#!/usr/bin/env bash
set -euo pipefail

until [[ -s /run/bowxt/session.env ]] && xdpyinfo -display "${DISPLAY:-:1}" >/dev/null 2>&1; do
  sleep 0.25
done
# shellcheck disable=SC1091
source /run/bowxt/session.env
export QT_LINUX_ACCESSIBILITY_ALWAYS_ON=1 NO_AT_BRIDGE=0
export XMODIFIERS=@im=fcitx GTK_IM_MODULE=fcitx QT_IM_MODULE=fcitx INPUT_METHOD=fcitx
export LIBGL_ALWAYS_SOFTWARE=1 QT_XCB_GL_INTEGRATION=none
export QTWEBENGINE_CHROMIUM_FLAGS="--disable-gpu --disable-dev-shm-usage"
exec /usr/bin/wechat
